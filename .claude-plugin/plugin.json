{
  "name": "ai-criteria",
  "description": "Log your AI's repeated mistakes as 3-field cases, roll them up weekly, and promote only recurring root causes into input/judgment criteria with applies-when / void-when. Local-first, zero dependencies.",
  "version": "0.4.0",
  "license": "MIT",
  "keywords": [
    "ai-quality",
    "mistakes",
    "lessons-learned",
    "guardrails",
    "local-first",
    "hooks",
    "claude-code"
  ],
  "author": {
    "name": "ai-criteria contributors"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "homepage": "https://github.com/phantomMillie/ai-criteria",
  "repository": "https://github.com/phantomMillie/ai-criteria"
}
